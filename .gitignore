# Build trees (created inside the tensorrt-dev container)
build/
# Isolated build tree the examples/*/Dockerfile convenience runners use
# (kept separate from build/ so they never reconfigure a dev build that's
# cached against a different Python - see any examples/*/Dockerfile).
.docker-build/
__pycache__/
*.pyc

# TensorRT engines are per-GPU, per-TRT-version artifacts - built locally
# from the committed .onnx exports (see models/README.md). Never committed.
*.engine

# NVIDIA Video Codec SDK: its license forbids redistribution. Download it
# yourself into third_party/Video_Codec_SDK/ (see third_party/ README).
third_party/Video_Codec_SDK/

# Stream-farm runtime artifacts + binaries + media (record your own clips;
# see tools/stream_farm/farm.sh header)
tools/stream_farm/bin/
tools/stream_farm/media/
tools/stream_farm/run/
tools/stream_farm/*.crt
tools/stream_farm/*.key

# Campaign/test-run artifacts from the python harnesses - never committed
python/*.log
python/_t*_*.csv
python/_t*_*.txt
python/*.ndjson
_b16_events.ndjson
# LibreOffice lock files
.~lock.*#
# Benchmark raw results (archived per-campaign into Reports; the folder
# itself ships empty)
# campaign results: keep the small CSV/latency summaries the README figures are built from,
# ignore the per-cell run logs and GPU samples
bench/results/**
!bench/results/*/
!bench/results/*.csv
!bench/results/*/cells.csv
!bench/results/*/latency_*.txt
!bench/results/ds_2026-09-04/
!bench/results/ds_2026-09-04/*.txt
MANUAL.docx
RELEASE_CHECKLIST.md
bench/deepstream/run_plate/
bench/deepstream/configs/app_*.txt
bench/.diyenv/
# parsers ship as source + Makefile; the .so is a container-built artifact
bench/deepstream/parsers/*.so
python/_routing_bench.csv

# Models
yolov8n_416_dynamic.onnx
yolov8n_1280_dynamic.onnx
rtdetr_l_dynamic.onnx
# ultralytics-derived exports: untracked via `git rm --cached` (AGPL heritage,
# see THIRD_PARTY.md) - ignored so `git add .` can't re-add them
models/yolov8n.onnx
models/yolov8n_dynamic.onnx
models/yolo26n.onnx
models/yolov8n_plates.onnx
models/yolov8n_plates_dynamic.onnx

# isolated venv for bench/diy_pynvc_trt.py (tensorrt wheel + pynvvideocodec + av)
.diyenv/
